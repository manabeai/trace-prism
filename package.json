{
  "name": "traceprism",
  "version": "0.2.0-preview.1",
  "description": "TracePrism native algorithm visualizer",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manabeai/trace-prism.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:tauri": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "tauri": "tauri",
    "build": "tsc --noEmit && vite build",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build:storybook": "storybook build --output-dir storybook-static",
    "test": "vitest run && playwright test",
    "prepare": "husky",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \".storybook/**/*.{ts,tsx,css}\" \"*.ts\" eslint.config.mjs package.json tsconfig.json tsconfig.test.json .github .lintstagedrc.json .prettierrc.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@corvu/resizable": "^0.2.5",
    "@eslint/js": "9.39.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/spline-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "0.8.10",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@tabler/icons-solidjs": "^3.48.0",
    "@tanstack/solid-table": "9.2.4",
    "@tauri-apps/cli": "~2.11.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.2",
    "eslint-plugin-solid": "0.18.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "solid-js": "1.9.15",
    "storybook": "^10.6.0",
    "storybook-solidjs-vite": "^10.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@typescript-eslint/utils": "8.55.0"
  }
}
