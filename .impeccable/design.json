  "narrative": {
    "northStar": "Field Notes",
    "overview": "競技プログラミングの実行を「読み返せる観察記録」として扱う。紙に近い面、細い罫線、控えめな緑を基調にし、seq と値の変化を読むことに視線を集中させる。装飾的なカードの積み重ねではなく、実行単位・span・値列という情報構造そのものを画面の階層にする。\n\nアプリと `/catalog` と Storybook は Field Notes の色・書体トークンを共有する。角丸や余白はコンポーネントと文脈に応じて調整する。比較用の `/flavors` は独立した検討資料であり、現行画面の規範ではない。",
    "keyCharacteristics": [
      "紙面とサイドバーの穏やかな面差、細い罫線。",
      "見出しは Newsreader、操作文は IBM Plex Sans、seq と値は IBM Plex Mono。",
      "緑は操作と選択、銅色は値の変化と一部の型マーカーに割り当てる。"
    ],
    "rules": [
      {
        "name": "The Change Color Rule",
        "body": "値セル内の銅色は「この観測点で変化した」という意味を保つ。色だけに依存せず、セルの形・境界・値も残す。",
        "section": "colors"
      },
      {
        "name": "The Three Voice Rule",
        "body": "見出し・操作・データの三つの声を混ぜない。同一セル内で複数書体が必要なら、役割の違いが読解に必要な場合に限る。",
        "section": "typography"
      }
    ],
    "dos": [
      "seq、span、値の階層を余白・罫線・書体で読ませる。",
      "差分を要素単位で示し、時系列を遡っても同じ意味を保つ。",
      "新しいコンポーネントを Storybook に実状態の story として追加する。"
    ],
    "donts": [
      "アルゴリズムの意味を一般的な値セルに埋め込む。Algo View の責務として扱う。",
      "銅色を通常のアクション色として使う。",
      "比較資料の色・書体を現行画面へ混ぜる。"
    ]
